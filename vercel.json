{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/analise-rotulos",
      "headers": [
        { "key": "Permissions-Policy", "value": "camera=(self)" }
      ]
    },
    {
      "source": "/analise-rotulos.html",
      "headers": [
        { "key": "Permissions-Policy", "value": "camera=(self)" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/agendar-consulta", "destination": "/agendar-consulta.html" },
    { "source": "/area-do-paciente", "destination": "/login.html" },
    { "source": "/blog", "destination": "/blog.html" },
    { "source": "/sobre", "destination": "/sobre.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/calendario", "destination": "/calendario.html" },
    { "source": "/acompanhamento-nutricional", "destination": "/acompanhamento-nutricional.html" },
    { "source": "/analise-rotulos", "destination": "/analise-rotulos.html" },
    { "source": "/espaco-paciente", "destination": "/espaco-paciente.html" },
    { "source": "/admin-espaco-paciente", "destination": "/admin-espaco-paciente.html" }
  ]
}